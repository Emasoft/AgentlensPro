{
  "name": "agentlenspro",
  "displayName": "AgentlensPro — Professional AI Agent Observability",
  "description": "AgentlensPro — professional observability for AI agent sessions: OTEL traces and local log file ingestion, CLI + server + skills. Standalone (npx) and Docker.",
  "version": "2.6.0",
  "publisher": "agentlens",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.9.0",
  "pnpm": {
    "minimumReleaseAge": 7200,
    "trustPolicy": "no-downgrade",
    "blockExoticSubdeps": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Emasoft/AgentlensPro.git"
  },
  "icon": "media/mascot.png",
  "keywords": [
    "ai",
    "agent",
    "opentelemetry",
    "telemetry",
    "observability",
    "copilot",
    "claude",
    "tracing"
  ],
  "categories": [
    "Other",
    "Visualization"
  ],
  "bin": {
    "agentlenspro": "./standalone/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "standalone/cli.js",
    "standalone/server.js",
    "scripts/safe_config_edit.py",
    "scripts/agentlens.plist.template",
    "media/dashboard.js",
    "media/dashboard.css",
    "media/sidebar.js",
    "media/icon.svg",
    "media/mascot.png",
    "media/help-mascot.png",
    "skills/"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "local": "node esbuild.js && node --max-old-space-size=6144 standalone/server.js",
    "up": "node esbuild.js && node standalone/cli.js dashboard",
    "up:supervised": "node esbuild.js && node standalone/cli.js server start --supervise",
    "supervise": "node standalone/cli.js server start --supervise",
    "mcp:ensure": "node standalone/cli.js server start",
    "dev": "node esbuild.js && npm-run-all -p watch:esbuild dev:server",
    "dev:server": "node scripts/dev-server.js",
    "demo": "node demo/run-ts.js demo/replay.ts",
    "demo:fast": "node demo/run-ts.js demo/replay.ts --speed 8",
    "demo:show": "node demo/run-ts.js demo/browser.ts",
    "demo:tour": "node demo/run-ts.js demo/browser.ts --tour",
    "capture": "node demo/run-ts.js demo/capture.ts",
    "capture:list": "node demo/run-ts.js demo/capture.ts --list",
    "fixtures:generate": "node demo/generate-fixtures.js",
    "fixtures:validate": "pnpm run compile-tests && node demo/validate-fixtures.js",
    "fixtures:check": "node demo/generate-fixtures.js --dir /tmp/agentlens-fixtures && pnpm run compile-tests && node demo/validate-fixtures.js --dir /tmp/agentlens-fixtures",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "deploy:safe": "bash scripts/safe-deploy.sh",
    "compile-tests": "tsc -p tsconfig.test.json",
    "watch-tests": "tsc -p tsconfig.test.json -w",
    "check-types": "tsc --noEmit && tsc --noEmit -p media/tsconfig.json",
    "check-mirrors": "node scripts/check-no-mirrors.js",
    "lint": "eslint src media/src",
    "test:unit": "pnpm run compile-tests && mocha",
    "test:browser": "pnpm run compile-tests && node esbuild.js && AGENTLENSPRO_BROWSER_TESTS=1 mocha --no-config --ui tdd out/test/test/browser/dashboardSmoke.test.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "mocha": "^11.7.6",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.60.0",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.4-r.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@preact/signals": "^2.9.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "preact": "^10.29.1",
    "sql.js": "^1.14.1"
  }
}
