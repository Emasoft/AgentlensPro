{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentlenspro:hook.Elicitation:v1",
  "title": "Claude Code hook input: Elicitation",
  "x-claude-code-version": "2.1.285",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "effort": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string"
        }
      },
      "required": [
        "level"
      ]
    },
    "elicitation_id": {
      "type": "string"
    },
    "hook_event_name": {
      "type": "string",
      "const": "Elicitation"
    },
    "mcp_server_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "form",
        "url"
      ]
    },
    "permission_mode": {
      "type": "string"
    },
    "prompt_id": {
      "type": "string"
    },
    "requested_schema": {
      "type": "object",
      "x-duckdb-type": "JSON"
    },
    "scratchpad_dir": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    },
    "url": {
      "type": "string"
    }
  },
  "required": [
    "cwd",
    "hook_event_name",
    "mcp_server_name",
    "message",
    "session_id",
    "transcript_path"
  ]
}
