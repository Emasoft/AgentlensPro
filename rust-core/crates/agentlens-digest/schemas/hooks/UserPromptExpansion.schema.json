{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentlenspro:hook.UserPromptExpansion:v1",
  "title": "Claude Code hook input: UserPromptExpansion",
  "x-claude-code-version": "2.1.285",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "command_args": {
      "type": "string"
    },
    "command_name": {
      "type": "string"
    },
    "command_source": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "effort": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string"
        }
      },
      "required": [
        "level"
      ]
    },
    "expansion_type": {
      "type": "string",
      "enum": [
        "slash_command",
        "mcp_prompt"
      ]
    },
    "hook_event_name": {
      "type": "string",
      "const": "UserPromptExpansion"
    },
    "permission_mode": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "prompt_id": {
      "type": "string"
    },
    "scratchpad_dir": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    }
  },
  "required": [
    "command_args",
    "command_name",
    "cwd",
    "expansion_type",
    "hook_event_name",
    "prompt",
    "session_id",
    "transcript_path"
  ]
}
