{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentlenspro:hook.ConfigChange:v1",
  "title": "Claude Code hook input: ConfigChange",
  "x-claude-code-version": "2.1.285",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "effort": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string"
        }
      },
      "required": [
        "level"
      ]
    },
    "file_path": {
      "type": "string"
    },
    "hook_event_name": {
      "type": "string",
      "const": "ConfigChange"
    },
    "permission_mode": {
      "type": "string"
    },
    "prompt_id": {
      "type": "string"
    },
    "scratchpad_dir": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "user_settings",
        "project_settings",
        "local_settings",
        "policy_settings",
        "skills"
      ]
    },
    "transcript_path": {
      "type": "string"
    }
  },
  "required": [
    "cwd",
    "hook_event_name",
    "session_id",
    "source",
    "transcript_path"
  ]
}
