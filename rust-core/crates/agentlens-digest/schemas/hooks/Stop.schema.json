{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentlenspro:hook.Stop:v1",
  "title": "Claude Code hook input: Stop",
  "x-claude-code-version": "2.1.285",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "background_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agent_type": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "server": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "description",
          "id",
          "status",
          "type"
        ]
      }
    },
    "cwd": {
      "type": "string"
    },
    "effort": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string"
        }
      },
      "required": [
        "level"
      ]
    },
    "hook_event_name": {
      "type": "string",
      "const": "Stop"
    },
    "last_assistant_message": {
      "type": "string"
    },
    "permission_mode": {
      "type": "string"
    },
    "prompt_id": {
      "type": "string"
    },
    "scratchpad_dir": {
      "type": "string"
    },
    "session_crons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "recurring": {
            "type": "boolean"
          },
          "schedule": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "prompt",
          "recurring",
          "schedule"
        ]
      }
    },
    "session_id": {
      "type": "string"
    },
    "stop_hook_active": {
      "type": "boolean"
    },
    "transcript_path": {
      "type": "string"
    }
  },
  "required": [
    "cwd",
    "hook_event_name",
    "session_id",
    "stop_hook_active",
    "transcript_path"
  ]
}
