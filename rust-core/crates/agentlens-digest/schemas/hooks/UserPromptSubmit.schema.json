{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentlenspro:hook.UserPromptSubmit:v1",
  "title": "Claude Code hook input: UserPromptSubmit",
  "x-claude-code-version": "2.1.285",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "effort": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string"
        }
      },
      "required": [
        "level"
      ]
    },
    "hook_event_name": {
      "type": "string",
      "const": "UserPromptSubmit"
    },
    "permission_mode": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "prompt_id": {
      "type": "string"
    },
    "scratchpad_dir": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "session_title": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "user",
        "sdk",
        "system",
        "loop_wakeup",
        "schedule_wakeup",
        "poll_event"
      ]
    },
    "transcript_path": {
      "type": "string"
    }
  },
  "required": [
    "cwd",
    "hook_event_name",
    "prompt",
    "session_id",
    "transcript_path"
  ]
}
