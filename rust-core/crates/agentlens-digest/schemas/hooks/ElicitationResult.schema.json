{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentlenspro:hook.ElicitationResult:v1",
  "title": "Claude Code hook input: ElicitationResult",
  "x-claude-code-version": "2.1.285",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "accept",
        "decline",
        "cancel"
      ]
    },
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "content": {
      "type": "object",
      "x-duckdb-type": "JSON"
    },
    "cwd": {
      "type": "string"
    },
    "effort": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string"
        }
      },
      "required": [
        "level"
      ]
    },
    "elicitation_id": {
      "type": "string"
    },
    "hook_event_name": {
      "type": "string",
      "const": "ElicitationResult"
    },
    "mcp_server_name": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "form",
        "url"
      ]
    },
    "permission_mode": {
      "type": "string"
    },
    "prompt_id": {
      "type": "string"
    },
    "scratchpad_dir": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "cwd",
    "hook_event_name",
    "mcp_server_name",
    "session_id",
    "transcript_path"
  ]
}
