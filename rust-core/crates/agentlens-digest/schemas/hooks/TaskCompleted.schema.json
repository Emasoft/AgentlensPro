{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentlenspro:hook.TaskCompleted:v1",
  "title": "Claude Code hook input: TaskCompleted",
  "x-claude-code-version": "2.1.285",
  "type": "object",
  "properties": {
