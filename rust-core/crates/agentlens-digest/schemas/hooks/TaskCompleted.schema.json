    "scratchpad_dir": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "task_description": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "task_subject": {
      "type": "string"
    },
    "team_name": {
      "type": "string"
    },
    "teammate_name": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    }
