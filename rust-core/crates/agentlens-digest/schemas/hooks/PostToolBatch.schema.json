{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentlenspro:hook.PostToolBatch:v1",
  "title": "Claude Code hook input: PostToolBatch",
  "x-claude-code-version": "2.1.285",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "effort": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string"
        }
      },
      "required": [
        "level"
      ]
    },
    "hook_event_name": {
      "type": "string",
      "const": "PostToolBatch"
    },
    "permission_mode": {
      "type": "string"
    },
    "prompt_id": {
      "type": "string"
    },
    "scratchpad_dir": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool_input": {
            "x-duckdb-type": "JSON"
          },
          "tool_name": {
            "type": "string"
          },
          "tool_response": {
            "x-duckdb-type": "JSON"
          },
          "tool_use_id": {
            "type": "string"
          }
        },
        "required": [
          "tool_input",
          "tool_name",
          "tool_use_id"
        ]
      }
    },
    "transcript_path": {
      "type": "string"
    }
  },
  "required": [
    "cwd",
    "hook_event_name",
    "session_id",
    "tool_calls",
    "transcript_path"
  ]
}
