            "service_tier": {
              "type": "string"
            },
            "speed": {
              "type": "string"
            },
            "inference_geo": {
              "type": "string"
            },
            "server_tool_use": {
              "x-duckdb-type": "JSON"
            },
            "output_tokens_details": {
              "x-duckdb-type": "JSON"
            },
            "iterations": {
              "x-duckdb-type": "JSON"
            },
            "fallback_credit": {
              "x-duckdb-type": "JSON"
            }
          }
        }
      }
    }
  }
}
