{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentlenspro:api_response.usage:v1",
  "title": "Anthropic Messages API response envelope: topic usage",
  "x-claude-code-version": "2.1.285",
  "type": "object",
  "properties": {
    "link": {
      "type": "object",
      "properties": {
        "body_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "message_uuid": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "query_source": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      }
    },
    "body": {
      "type": "object",
      "properties": {
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer"
            },
            "output_tokens": {
              "type": "integer"
