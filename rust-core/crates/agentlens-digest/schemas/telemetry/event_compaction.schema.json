      "type": "string",
      "enum": [
        "hit",
        "miss_custom_instructions",
        "miss_hook",
        "miss_not_ready"
      ]
    },
    "prompt.id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "service.name": {
      "type": "string"
    },
    "service.version": {
      "type": "string"
    },
    "session.id": {
      "type": "string"
    },
    "success": {
      "type": "string",
