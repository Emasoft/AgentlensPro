    },
    "error": {
      "type": "string"
    },
    "event.name": {
      "type": "string",
      "const": "compaction"
    },
    "event.sequence": {
      "type": "integer"
    },
    "event.timestamp": {
      "type": "string"
    },
    "host.arch": {
      "type": "string"
    },
    "message.uuid": {
      "type": "string"
    },
    "organization.id": {
      "type": "string"
    },
    "os.type": {
      "type": "string"
    },
    "os.version": {
      "type": "string"
    },
    "post_tokens": {
      "type": "string"
    },
    "pre_tokens": {
      "type": "string"
    },
