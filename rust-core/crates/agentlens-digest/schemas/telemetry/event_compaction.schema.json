    "vcs.owner.name": {
      "type": "string"
    },
    "vcs.provider.name": {
      "type": "string"
    },
    "vcs.repository.name": {
      "type": "string"
    },
    "vcs.repository.url.full": {
      "type": "string"
    },
    "wsl.version": {
      "type": "string"
    }
