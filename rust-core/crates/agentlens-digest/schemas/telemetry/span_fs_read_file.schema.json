{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentlenspro:telemetry.span.fs_read_file:v1",
  "title": "OTel span fs_read_file attributes (not emitted by Claude Code)",
  "type": "object",
  "properties": {
    "busy_ns": {
      "type": "integer"
    },
    "code.file.path": {
      "type": "string"
    },
    "code.line.number": {
      "type": "integer"
    },
    "code.module.name": {
      "type": "string"
    },
    "idle_ns": {
      "type": "integer"
    },
    "sandboxed": {
      "type": "boolean"
    },
    "target": {
      "type": "string"
    },
    "thread.id": {
      "type": "integer"
    },
    "thread.name": {
      "type": "string"
    },
    "_span": {
      "type": "object",
      "properties": {
        "traceId": {
          "type": "string"
        },
        "spanId": {
          "type": "string"
        },
        "parentSpanId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "startTimeUnixNano": {
          "type": "integer"
        },
        "endTimeUnixNano": {
          "type": "integer"
        },
        "status": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
