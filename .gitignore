# Captured fixture files contain real telemetry — opt-in to commit specific ones
demo/fixtures/*.json
# Session data exports
export_*.json
agent-lens-export-*.json
# Local staging
.staged-issues/
# Claude Code settings. settings.json is PROJECT scope and IS tracked — it carries the
# repo's shared agent policy (currently one PreToolUse deny hook), so a clone inherits it.
# settings.local.json stays per-developer: personal permissions, machine paths, experiments.
.claude/settings.local.json
# ai-maestro-janitor runtime state (per-session, regeneratable — never commit)
.claude/janitor/
.janitor/
# Agent reports (may contain private paths/tokens — never commit)
/reports/
/reports_dev/
# Dev-only scratch (measurement harnesses, e2e runners, downloaded corpora) — never published.
# The catch-all is deliberate: the enumerated list below kept missing new ones (`_corpus_dev/`), and
# a `_dev` folder that is NOT ignored is the failure mode that leaks a downloaded third-party corpus
# or a private measurement dump into the repo. Any depth, so a nested `foo/bar_dev/` is covered too.
*_dev/
/scripts_dev/
/docs_dev/
/samples_dev/
/examples_dev/
/tests_dev/
/downloads_dev/
/libs_dev/
/builds_dev/
# npm pack output (regeneratable) — never commit
*.tgz

# tldr CLI index caches + local config (regenerable, machine-local) and editor swap files —
# they kept the dirty-tree detector firing on artifacts that must never be committed.
.tldr/
.tldrignore
*.swp

# Janitor detector OUTPUT inside the memory store — NOT memory pages (no node frontmatter);
# they are regenerated on every sweep and describe a moment, not a fact. PROJECT memory is
# tracked AND PUSHED, so committing one ships a snapshot finding to every cloner — and a
# stale "2 pages leak private data" file is worse than none, since the reader cannot tell
# it was investigated and dismissed. The verdicts belong in the pages themselves as dated
# lessons (see ATOM-DETECTOR-MATCHED-ITS-OWN-VOCABULARY); the scratch file does not.
.claude/project/memory/*-proposed.md
/.trashcan/*
!/.trashcan/.gitkeep
!/.trashcan/README.txt

# gen-forensicsindexer-expected.mjs writes a main agentlens.db and a forensics.db beside its spool.
# Both are regeneratable binaries whose only content is one sessions row and the indexed output; the
# Rust parity test builds its own rather than reading them, so committing them would ship two binary
# blobs nothing consumes.
rust-core/crates/agentlens-core/tests/fixtures/forensicsindexer/*.db
