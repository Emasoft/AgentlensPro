.DS_Store
out
dist
node_modules
.vscode-test/
*.vsix
standalone/server.js
standalone/server.js.map
standalone/cli.js
standalone/cli.js.map
media/dashboard.js
media/dashboard.js.map
media/dashboard.css
media/dashboard.css.map
media/sidebar.js
media/sidebar.js.map
# Captured fixture files contain real telemetry — opt-in to commit specific ones
demo/fixtures/*.json
# Session data exports
export_*.json
agent-lens-export-*.json
# Local staging
.staged-issues/
# Claude Code per-developer settings (permissions, hooks — not project config)
.claude/settings.json
.claude/settings.local.json
# ai-maestro-janitor runtime state (per-session, regeneratable — never commit)
.claude/janitor/
.janitor/
# Agent reports (may contain private paths/tokens — never commit)
/reports/
/reports_dev/
# Dev-only scratch (measurement harnesses, e2e runners) — never published
/scripts_dev/
/docs_dev/
/samples_dev/
/examples_dev/
/tests_dev/
/downloads_dev/
/libs_dev/
/builds_dev/
# npm pack output (regeneratable) — never commit
*.tgz

# tldr CLI index caches + local config (regenerable, machine-local) and editor swap files —
# they kept the dirty-tree detector firing on artifacts that must never be committed.
.tldr/
.tldrignore
*.swp
