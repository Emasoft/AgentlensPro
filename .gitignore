.DS_Store
out
dist
node_modules
# Rust build artifacts (TRDD-DMWOBWFH)
rust-core/target/
.vscode-test/
*.vsix
standalone/server.js
standalone/server.js.map
standalone/cli.js
standalone/cli.js.map
media/dashboard.js
media/dashboard.js.map
media/dashboard.css
media/dashboard.css.map
media/sidebar.js
