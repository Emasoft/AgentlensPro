enable-pre-post-scripts = true

# Supply-chain hardening (pnpm >=10.16 / 11.x) — janitor package-manager-policy baseline.
# Delay installing versions published <7200 min (5 days) ago; refuse silent downgrades;
# block sub-deps resolved from non-registry (exotic) sources. Mirrored in package.json "pnpm".
minimum-release-age = 7200
trust-policy = no-downgrade
block-exotic-subdeps = true